{
  "manifest_version": 3,
  "name": "Reborn BF – Appli",
  "version": "1.0.0",
  "description": "Menu rapide, bots, x2 automatique et fiche d’unité remaster pour Reborn BF.",
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://rebornbf.com/*",
        "https://*.rebornbf.com/*"
      ],
      "js": [
        "native.js",
        "perf.js",
        "antipause.js",
        "appfeel.js",
        "nav.js",
        "gamedata.js",
        "unitplus.js",
        "gameinfo.js",
        "combat.js",
        "farm.js",
        "aventure.js",
        "ui.js",
        "custom.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://assets.rebornbf.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "hd",
        "enabled": true,
        "path": "hd_rules.json"
      }
    ]
  }
}